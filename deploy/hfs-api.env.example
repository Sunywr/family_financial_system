RUST_LOG=hfs_backend=info,tower_http=info
HFS__APP__HOST=127.0.0.1
HFS__APP__PORT=8080

# Main database (HFS)
HFS__DATABASE__URL=mysql://hfs:replace_me@127.0.0.1:3306/hfs
HFS__DATABASE__MIN_CONNECTIONS=0
HFS__DATABASE__MAX_CONNECTIONS=8
HFS__DATABASE__CONNECT_TIMEOUT_SECS=5
HFS__DATABASE__IDLE_TIMEOUT_SECS=300
HFS__DATABASE__ACQUIRE_TIMEOUT_SECS=5
HFS__DATABASE__LAZY_CONNECT=true

# Legacy database (PFM)
HFS__LEGACY_DATABASE__URL=mysql://pfm:replace_me@127.0.0.1:3306/pfm
HFS__LEGACY_DATABASE__MIN_CONNECTIONS=0
HFS__LEGACY_DATABASE__MAX_CONNECTIONS=4
HFS__LEGACY_DATABASE__CONNECT_TIMEOUT_SECS=5
HFS__LEGACY_DATABASE__IDLE_TIMEOUT_SECS=300
HFS__LEGACY_DATABASE__ACQUIRE_TIMEOUT_SECS=5
HFS__LEGACY_DATABASE__LAZY_CONNECT=true

HFS__AUTH__JWT_SECRET=replace-with-long-random-secret
HFS__SCHEDULER__TICK_SECONDS=30
